# Browser configuration. Sign-in is unavailable until the public app ID is set.
VITE_PRIVY_APP_ID=
VITE_PUBLIC_ORIGIN=
# Only after authorized deployment:
VITE_JANUS_PURCHASE_ADDRESS=

# Put the following in ignored .env.server, not in the browser bundle.
# Public app ID must match VITE_PRIVY_APP_ID.
PRIVY_APP_ID=
# Optional PEM override. Leave blank to use Privy JWKS automatically.
PRIVY_VERIFICATION_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Exact public production origin, for example https://januswallet.xyz
JANUS_ORIGIN=http://localhost:5173
JANUS_PURCHASE_ADDRESS=
API_PORT=3001
API_HOST=127.0.0.1
