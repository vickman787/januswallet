{
  "name": "studio-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "deploy:self": "bun run ./scripts/self-deploy.ts",
    "fetch:abi": "bun run ./scripts/fetch-abi.ts",
    "typecheck": "tsc --noEmit",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "build": "vite build",
    "test": "tsx --test tests/*.test.mts",
    "test:browser": "node tests/browser-check.mjs",
    "lint": "oxlint --type-aware src scripts server",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev:api": "node --env-file-if-exists=.env.server --import tsx server/index.ts",
    "test:browser:auth": "node tests/auth-browser-check.mjs",
    "contracts:preflight": "node scripts/check-arc-purchase-environment.mjs"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.18.0",
    "@circle-fin/app-kit": "^1.15.2",
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@circle-fin/modular-wallets-core": "^1.0.16",
    "@circle-fin/smart-contract-platform": "^10.8.0",
    "@circle-fin/user-controlled-wallets": "^10.8.0",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@openzeppelin/contracts": "5.1.0",
    "@privy-io/react-auth": "^3.50.0",
    "@privy-io/wagmi": "4.0.19",
    "@stripe/stripe-js": "^1.46.0",
    "@tanstack/react-query": "^5.62.7",
    "@web3icons/react": "^4.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "viem": "^2.56.3",
    "wagmi": "^2.19.5"
  },
  "overrides": {
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsqr": "^1.4.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.4.49",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
